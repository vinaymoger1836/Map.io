{
  "name": "eurasia-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:warsim:physics": "node --import tsx scripts/validate-warsim-physics.ts",
    "test:e2e": "playwright test --project=chromium",
    "bench:warsim": "node --expose-gc --import tsx scripts/benchmark-warsim.ts",
    "bench:warsim:browser": "playwright test --project=baseline",
    "bench:warsim:runtime": "node --expose-gc --import tsx scripts/benchmark-warsim.ts --runtime",
    "bench:warsim:joint": "node scripts/benchmark-warsim-joint-runner.cjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  }
}
